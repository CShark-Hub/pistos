{
  "schema": 1,
  "name": "go",
  "version": "0.1.0",
  "languages": ["go"],
  "test_paths": ["**/*_test.go", "**/testdata/**"],
  "options": ["tags", "goos", "goarch", "cgo_enabled"],
  "env_passthrough": ["GOPATH", "GOMODCACHE", "GOCACHE", "GOPRIVATE", "GONOSUMDB", "GOINSECURE", "GOEXPERIMENT"],
  "shared_inputs": ["go.work", "go.work.sum"],
  "tools": {
    "go": {
      "command": "go",
      "lookup": ["path"],
      "version_args": ["env", "GOVERSION"],
      "version_regex": "^go([0-9][^\\s]*)"
    },
    "staticcheck": {
      "command": "staticcheck",
      "lookup": ["managed", "path"],
      "version_args": ["-version"],
      "version_regex": "\\((v?[0-9][^)]*)\\)",
      "acquire": {"method": "go-install", "package": "honnef.co/go/tools/cmd/staticcheck", "version": "v0.8.1"}
    }
  },
  "checks": {
    "go-vet": {
      "tool": "go",
      "args": ["vet", "-p={jobs}", "-json", "-tags={opt:tags}", "./..."],
      "format": "go-vet",
      "scope": "project",
      "weight": 2,
      "exit_codes": {"0": "clean", "1": "findings"},
      "env": {"GOFLAGS": "-mod=readonly", "GOPROXY": "off", "GOTOOLCHAIN": "local", "GOOS": "{opt:goos}", "GOARCH": "{opt:goarch}", "CGO_ENABLED": "{opt:cgo_enabled}"},
      "limitations": ["go vet reports only the first type error per package and skips its analyzers for that package"]
    },
    "staticcheck": {
      "tool": "staticcheck",
      "uses": ["go"],
      "args": ["-f", "json", "-tags={opt:tags}", "./..."],
      "format": "staticcheck-json",
      "scope": "project",
      "weight": 2,
      "exit_codes": {"0": "clean", "1": "findings"},
      "env": {"GOFLAGS": "-mod=readonly", "GOPROXY": "off", "GOTOOLCHAIN": "local", "GOOS": "{opt:goos}", "GOARCH": "{opt:goarch}", "CGO_ENABLED": "{opt:cgo_enabled}", "STATICCHECK_CACHE": "{cache}"}
    }
  },
  "aliases": {
    "staticcheck/SA5009": "go-vet/printf",
    "go-vet/typecheck": "go/typecheck",
    "go-vet/load": "go/load",
    "staticcheck/compile": "go/typecheck"
  },
  "authority": ["go-vet", "staticcheck"]
}
