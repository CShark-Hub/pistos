<Project Sdk="Microsoft.NET.Sdk">
  <!-- Built by `pistos plugins install` against the Roslyn assemblies bundled with the installed SDK,
       so no package download is needed and the parser matches the compiler that builds the code. -->
  <PropertyGroup>
    <!-- Install passes PistosTargetFramework explicitly; building the project directly (e.g. pistos checking
         its own repo) falls back to the newest framework the running SDK ships. -->
    <PistosTargetFramework Condition="'$(PistosTargetFramework)' == ''">net$(BundledNETCoreAppTargetFrameworkVersion)</PistosTargetFramework>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(PistosTargetFramework)</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RollForward>Major</RollForward>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RoslynDir Condition="'$(RoslynDir)' == ''">$(RoslynTargetsPath)/bincore</RoslynDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis"><HintPath>$(RoslynDir)/Microsoft.CodeAnalysis.dll</HintPath></Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp"><HintPath>$(RoslynDir)/Microsoft.CodeAnalysis.CSharp.dll</HintPath></Reference>
  </ItemGroup>
</Project>
